JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# LLM
LLM_PROVIDER=ollama
LLM_TIMEOUT=180
LLM_RETRY_ATTEMPTS=2

LLM_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=
LLM_MAX_TOKENS=10000
LLM_TEMPERATURE=0.0

OLLAMA_MODEL=qwen3.5:4b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=8192

# API
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=False

# Postgres
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DATABASE=tendering

# IMAP (lecture des emails)
IMAP_EMAIL=
IMAP_PASSWORD=
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993

# SMTP (envoi des emails)
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Embidding
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
EMBEDDING_CACHE_DIR=data/models
EMBEDDING_LOCAL_FILES_ONLY=false
SEMANTIC_TOP_N=5

# LangSmith
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=tendering-ia
# Facultatif : requis uniquement si la clé couvre plusieurs workspaces.
LANGSMITH_WORKSPACE_ID=
# Compatibilité avec les anciens noms (laisser vides si LANGSMITH_* est utilisé).
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=tendering-ia

# OCR
OCR_MAX_WORKERS=2
